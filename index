    const adminEl = document.getElementById('module-admin');
    if (adminEl) adminEl.classList.add('hidden');
    document.getElementById('module-contact').classList.remove('hidden');
    window.scrollTo(0, 0);
  }
  function handleContactSubmit() {
    const toast = document.getElementById('toast');
    toast.textContent = '✅ Message sent! We\'ll get back to you within 24 hours.';
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3500);
